POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=change-me

SECRET_KEY=dev-secret-change-me

# 当日配布される CPaaS NOW の開発/本番環境URL・APIトークンに差し替える
NEXWAY_API_BASE_URL=https://example.invalid
